rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    // Lid = profiel bestaat en toegang is niet ingetrokken
    function isMember() { return signedIn() && exists(memberPath()) && get(memberPath()).data.get('blocked', false) != true; }
    function isAdmin() { return isMember() && get(memberPath()).data.get('role', '') == 'admin'; }
    // Manager padelhal (of admin): beheert de deurcodes
    function isManager() { return isMember() && get(memberPath()).data.get('role', '') in ['manager', 'admin']; }

    // Max 4 spelers per slot, 1 of 2 slots per boeking.
    function slotsOk(d) {
      return d.slots is list
        && d.slots.size() >= 1 && d.slots.size() <= 2
        && d.slots[0].players is list && d.slots[0].players.size() <= 4
        && (d.slots.size() == 1 || (d.slots[1].players is list && d.slots[1].players.size() <= 4));
    }

    // Instellingen van het vaste communityveld
    match /config/settings {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Uitnodigingscode: enkel admins kunnen ze lezen en wijzigen
    match /config/invite {
      allow read, write: if isAdmin();
    }

    // Extra vaste velden
    match /recurring/{recId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if isMember() || (signedIn() && request.auth.uid == memberId);

      // Registreren kan alleen met de juiste uitnodigingscode, en je kan jezelf geen admin maken.
      allow create: if signedIn()
        && request.auth.uid == memberId
        && request.resource.data.inviteCode == get(/databases/$(db)/documents/config/invite).data.code
        && !('role' in request.resource.data)
        && !('blocked' in request.resource.data);

      // Eigen profiel aanpassen kan, maar niet je rol of toegang; een geblokkeerd lid kan niets meer wijzigen.
      allow update: if (isMember() && request.auth.uid == memberId
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'inviteCode', 'blocked']))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // Deurcode van de padelhal per sessie.
    // Lezen: manager/admin, of wie in die sessie speelt (of er een gast toevoegde).
    // De maker van een eigen veld mag de code van dat veld ook lezen en instellen.
    match /doorCodes/{bookingId} {
      function session() { return get(/databases/$(db)/documents/bookings/$(bookingId)).data; }
      allow read: if isManager()
        || (isMember() && (request.auth.uid in session().get('accessUids', [])
                           || session().get('createdBy', '') == request.auth.uid));
      allow write: if isManager()
        || (isMember() && session().get('type', '') == 'member' && session().get('createdBy', '') == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if isMember();

      allow create: if isMember() && slotsOk(request.resource.data) && (
          // Eigen bijgeboekt veld
          (request.resource.data.type == 'member' && request.resource.data.createdBy == request.auth.uid)
          // Communitysessie wordt aangemaakt bij de eerste inschrijving (of door een admin bij annulatie)
          || (request.resource.data.type == 'community'
              && (bookingId == 'community_' + request.resource.data.date
                  || bookingId == 'community_' + request.resource.data.get('recurringId', '') + '_' + request.resource.data.date)
              && (request.resource.data.cancelled == false || isAdmin()))
        );

      // Eigenaar en admins mogen alles wijzigen; andere leden alleen de spelerslijsten.
      allow update: if isMember() && slotsOk(request.resource.data) && (
          isAdmin()
          || (resource.data.createdBy == request.auth.uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type', 'createdBy']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'accessUids', 'updatedAt'])
          // Manager padelhal mag daarnaast het veldnummer instellen
          || (isManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'accessUids', 'court', 'updatedAt']))
        );

      allow delete: if isMember() && (
          (resource.data.type == 'member' && resource.data.createdBy == request.auth.uid) || isAdmin()
        );
    }
  }
}
